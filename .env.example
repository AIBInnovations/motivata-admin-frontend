# Copy to .env.local (git-ignored) and adjust.
#
# VITE_* values are embedded in the client bundle at build time and are
# visible to anyone who loads the app. Never put secrets in them.

# Backend API base URL, including the /api prefix. Required for production
# builds; `npm run build` fails without it.
# Production:
VITE_API_BASE_URL=https://motivata.synquic.com/api
# Local backend:
# VITE_API_BASE_URL=http://localhost:5000/api

# /test-services performs real backend mutations. It is always available in
# `npm run dev`; production builds include it only when this is exactly
# "true". Keep it false outside an explicitly controlled test environment.
VITE_ENABLE_TEST_SERVICES=false
